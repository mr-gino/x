# (f)
# P(Zh=k oraz Zj-Zi=m)

print("\n")
print("(f)")

wynik = 0

for y1 in range(50):
    for y2 in range(50):
        if h >= j:
            pZh = poisson.pmf(
                k-2*y1,
                lam*h
            ) * poisson.pmf(
                y1,
                mi*h
            )

            pInc = poisson.pmf(
                m-2*y2,
                lam*(j-i)
            ) * poisson.pmf(
                y2,
                mi*(j-i)
            )

            wynik += pZh*pInc

print("P(Zh=k oraz Zj-Zi=m) =", wynik)

