# (c)
# P(Xg=g | Xe=f)

print("\n")
print("(c)")

if g >= e and g >= f:
    wynik = poisson.pmf(g-f, lam*(g-e))
else:
    wynik = 0

print("P(Xg=g | Xe=f) =", wynik)

# (d)
# P(Xn = p oraz Z(n+1)=q)

print("\n")
print("(d)")

"""
Z(n+1)=X(n+1)+2Y(n+1)

sumujemy po wszystkich możliwych wartościach Y
"""

wynik = 0

for y in range(q+1):
    if (q-2*y) >= p:
        pxn = poisson.pmf(p, lam*n)
        pxinc = poisson.pmf(
            (q-2*y)-p,
            lam
        )
        py = poisson.pmf(y, mi*(n+1))
        wynik += pxn*pxinc*py

print("P(Xn=p oraz Z(n+1)=q) =", wynik)

