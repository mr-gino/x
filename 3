import numpy as np
import matplotlib.pyplot as plt
from statsmodels.distributions.empirical_distribution import ECDF
from scipy.stats import poisson, norm

X = np.load(f"probka_10.npy")

EX = np.mean(X)
VarX = np.var(X)

print("E(X) =", EX)
print("Var(X) =", VarX)

# 1a F_X oraz f_X
F_X = ECDF(X)
x_ls = np.linspace(min(X), max(X), 2000)
F_ls = np.array([F_X(x) for x in x_ls])
f_ls = np.gradient(F_ls, x_ls)
f_ls = np.where(f_ls < 0, 0, f_ls)

plt.figure()
plt.plot(F_X.x, F_X.y)
plt.title("Dystrybuanta empiryczna F_X")
plt.grid()
plt.show()

plt.figure()
plt.plot(x_ls, f_ls)
plt.title("Gestosc f_X")
plt.grid()
plt.show()

# 1b Cov(X,Y) ~ 1
Y = X + 0.01*np.random.randn(len(X))

print("\n1a   Cov~1")
print("E(X) =", np.mean(X))
print("E(Y) =", np.mean(Y))
print("Var(X) =", np.var(X))
print("Var(Y) =", np.var(Y))
print("Cov(X,Y) =", np.cov(X,Y)[0,1])

px = np.mean(
    X < min(X)+(np.mean(X)-min(X))/2
)

py = np.mean(
    Y < min(Y)+(np.mean(Y)-min(Y))/2
)

print("P(X<...) =", px)
print("P(Y<...) =", py)

# 1b Cov(X,Y) ~ 0
