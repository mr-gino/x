# 3a a=3 zdarzeń w przedziale czasowym (2,6] i b=2 zdarzeń - w (5,9]
lam = 1
a = 3
b = 2

P1 = poisson.pmf(a, lam*(6-2))
P2 = poisson.pmf(b, lam*(9-5))

print("\n3a")
print("P(Z(6)-Z(2)=3) =", P1)
print("P(Z(9)-Z(5)=2) =", P2)

# 3b
lam = 1      # <-- intensywność

t1 = 2       # <-- wcześniejsza chwila
t2 = 3       # <-- późniejsza chwila

k = 2        # <-- Z_t1 = k
n = 3        # <-- Z_t2 = n

P = (
    poisson.pmf(k, lam*t1)
    *
    poisson.pmf(n-k, lam*(t2-t1))
    /
    poisson.pmf(n, lam*t2)
)

print("\n3b")
print(f"P(Z{t1}={k} | Z{t2}={n}) =", P)

