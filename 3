dt = 0.1
t_ls = np.arange(0.1, 2.1, dt)

PY = []

for t in t_ls:
    # 2a
    # EY = EX*t
    # VarY = VarX*t*t/4

    # 2b
    # EY = EX*t/2
    # VarY = VarX*t*t

    # 2c
    # EY = 2*EX/t
    # VarY = 4*VarX*t*t

    # 2d
    EY = 2*EX*t
    VarY = VarX*t*t/4

    Yt = EY + np.sqrt(VarY)*np.random.randn(len(X))

    PY.append(
        np.mean(
            Yt < (EX-min(X))/2
        )
    )

t = 1

